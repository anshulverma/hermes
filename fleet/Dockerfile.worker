# Hermes fleet worker image.
#
# A stateless worker node: sshd + the hermes worker-runner + the MockAgent + the
# no-ship guard shims, all baked. Reached only via master-initiated SSH. The
# master scps an envelope up, runs `hermes serve-once --agent mock`, scps the
# result back. Determinism comes from the MASTER's MockAgent scenario table; the
# worker just executes the trivial mock invocation.
#
# Build with host networking so apt reaches the mirrors behind the proxy:
#   podman build --network=host -f fleet/Dockerfile.worker -t hermes-fleet-worker .
#
# Auth is hermetic: the entrypoint writes $HERMES_AUTHORIZED_KEY (a throwaway
# public key generated by the harness) into root's authorized_keys at start, so
# no credentials are baked into the image.
FROM docker.io/library/python:3.12-slim

# openssh-server for the real ssh transport; coreutils (timeout/true) ship in base.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/run/sshd /root/.ssh \
    && chmod 700 /root/.ssh

# Ship the engine + agents + sites + testkit (MockAgent) so the worker-runner
# and `hermes serve-once --agent mock` work. No pip install: the flat repo layout
# has several top-level packages, so we run via PYTHONPATH + a thin CLI wrapper
# (avoids setuptools flat-layout auto-discovery ambiguity).
WORKDIR /opt/hermes
COPY engine/ /opt/hermes/engine/
COPY agents/ /opt/hermes/agents/
COPY sites/ /opt/hermes/sites/
COPY testkit/ /opt/hermes/testkit/
COPY pyproject.toml README.md /opt/hermes/

# Thin `hermes` CLI wrapper on PATH (no console-script install needed).
RUN printf '#!/bin/sh\nexec python3 -m engine.cli "$@"\n' > /usr/local/bin/hermes \
    && chmod +x /usr/local/bin/hermes

# No-ship guard shims: shadow git/sl/hg/jf/arc and refuse push/land. Baked
# early on PATH so any land/push a worker attempts is blocked by construction.
RUN mkdir -p /opt/hermes-guard/bin \
    && for pair in "git:push" "sl:push land" "hg:push" "jf:land" "arc:land"; do \
         name="${pair%%:*}"; blocked="${pair#*:}"; \
         { \
           echo '#!/bin/sh'; \
           echo "# hermes no-ship guard shim for $name"; \
           echo 'for _a in "$@"; do case "$_a" in'; \
           for b in $blocked; do echo "  $b) echo \"[hermes-no-ship-guard] blocked '$name $b'\" >&2; exit 97;;"; done; \
           echo 'esac; done'; \
           real="$(command -v "$name" || true)"; \
           if [ -n "$real" ]; then echo "exec $real \"\$@\""; else echo "exit 0"; fi; \
         } > "/opt/hermes-guard/bin/$name"; \
         chmod +x "/opt/hermes-guard/bin/$name"; \
       done

# sshd: pubkey-only, no passwords, and PermitUserEnvironment so the ssh command
# session picks up HERMES_AGENT / PYTHONPATH / PATH from ~/.ssh/environment
# (Docker ENV is NOT inherited by sshd-exec'd commands).
RUN sed -i \
      -e 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' \
      -e 's/^#\?PubkeyAuthentication.*/PubkeyAuthentication yes/' \
      -e 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' \
      -e 's/^#\?PermitUserEnvironment.*/PermitUserEnvironment yes/' \
      /etc/ssh/sshd_config \
    && ssh-keygen -A \
    && printf 'HERMES_AGENT=mock\nPYTHONPATH=/opt/hermes\nPATH=/opt/hermes-guard/bin:/usr/local/bin:/usr/bin:/bin\n' \
       > /root/.ssh/environment \
    && chmod 600 /root/.ssh/environment

# Resource class + counts for the reference compose topology (informational; the
# host-as-master test passes resources via the master's SSHSite config).
ENV HERMES_SSH_RESOURCES='{"cpu":4}'
ENV HERMES_AGENT=mock
ENV PYTHONPATH=/opt/hermes

COPY fleet/entrypoint.sh /usr/local/bin/hermes-worker-entrypoint
RUN chmod +x /usr/local/bin/hermes-worker-entrypoint

EXPOSE 22
ENTRYPOINT ["/usr/local/bin/hermes-worker-entrypoint"]
